@model PAW.Models.DTO.InventoryDTO

@* Campos compartidos por Create y Edit *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="UnitPrice" class="form-label"></label>
        <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="UnitsInStock" class="form-label"></label>
        <input asp-for="UnitsInStock" type="number" step="1" class="form-control" />
        <span asp-validation-for="UnitsInStock" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ProductId" class="form-label"></label>
        <input asp-for="ProductId" type="number" step="1" class="form-control" />
        <span asp-validation-for="ProductId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ModifiedBy" class="form-label"></label>
        <input asp-for="ModifiedBy" class="form-control" />
        <span asp-validation-for="ModifiedBy" class="text-danger small"></span>
    </div>
</div>
