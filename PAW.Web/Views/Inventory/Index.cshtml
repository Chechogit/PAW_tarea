@model InventoryViewModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="container mt-4">

    @await Html.PartialAsync("ExchangeRate", Model.TipoCambio)

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventory</h2>

        <a asp-action="Create" class="btn btn-primary">
            Add Inventory
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Inventory ID</th>
                            <th>Unit Price</th>
                            <th>Units In Stock</th>
                            <th>Product ID</th>
                            <th>Date Added</th>
                            <th>Last Updated</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Inventories.Items.Any())
                        {
                            foreach (var item in Model.Inventories.Items)
                            {
                                <tr>
                                    <td>@item.InventoryId</td>
                                    <td>@item.UnitPrice?.ToString("N2")</td>
                                    <td>@item.UnitsInStock</td>
                                    <td>@item.ProductId</td>
                                    <td>@item.DateAdded?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.ModifiedBy</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.InventoryId"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.InventoryId"
                                               data-details="Inventory details"
                                               class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.InventoryId"
                                               class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">
                                    No records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_Pager" model="Model.Inventories" />

        </div>
    </div>

</div>
