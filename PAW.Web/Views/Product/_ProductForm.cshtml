@model PAW.Models.DTO.ProductDTO

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Rating" class="form-label"></label>
        <input asp-for="Rating" type="number" step="0.01" min="0" max="5" class="form-control" />
        <span asp-validation-for="Rating" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label"></label>
        <input asp-for="CategoryId" type="number" min="1" class="form-control" />
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="InventoryId" class="form-label"></label>
        <input asp-for="InventoryId" type="number" min="1" class="form-control" />
        <span asp-validation-for="InventoryId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SupplierId" class="form-label"></label>
        <input asp-for="SupplierId" type="number" min="1" class="form-control" />
        <span asp-validation-for="SupplierId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CreatedBy" class="form-label"></label>
        <input asp-for="CreatedBy" class="form-control" readonly="@(Model.ProductId > 0)" />
        <span asp-validation-for="CreatedBy" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ModifiedBy" class="form-label"></label>
        <input asp-for="ModifiedBy" class="form-control" />
        <span asp-validation-for="ModifiedBy" class="text-danger small"></span>
    </div>
</div>