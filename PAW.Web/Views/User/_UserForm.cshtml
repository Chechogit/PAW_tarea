@model PAW.Models.DTO.UserDTO

@* Campos compartidos por Create y Edit *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PasswordHash" class="form-label"></label>
        <input asp-for="PasswordHash" class="form-control" />
        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="RoleId" class="form-label"></label>
        <input asp-for="RoleId" type="number" step="1" class="form-control" />
        <span asp-validation-for="RoleId" class="text-danger small"></span>
    </div>

    <div class="col-md-6 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-md-6">
        <label asp-for="ModifiedBy" class="form-label"></label>
        <input asp-for="ModifiedBy" class="form-control" />
        <span asp-validation-for="ModifiedBy" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="LastModifiedBy" class="form-label"></label>
        <input asp-for="LastModifiedBy" class="form-control" />
        <span asp-validation-for="LastModifiedBy" class="text-danger small"></span>
    </div>
</div>
