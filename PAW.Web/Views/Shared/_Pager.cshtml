@model PAW.Models.IPagedResult

@{
    var current = Model.Page;
    var last = Model.TotalPages;

    var start = Math.Max(1, current - 1);
    var end = Math.Min(last, start + 2);
    start = Math.Max(1, end - 2);

    var from = Model.TotalCount == 0 ? 0 : (current - 1) * Model.PageSize + 1;
    var to = Math.Min(current * Model.PageSize, Model.TotalCount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">

    <small class="text-muted">Showing @from–@to of @Model.TotalCount</small>

    @if (last > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination mb-0">

                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1" aria-label="First page">&laquo;</a>
                </li>

                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(current - 1)" aria-label="Previous page">&lsaquo;</a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }

                @for (var i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")" aria-current="@(i == current ? "page" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                @if (end < last)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }

                <li class="page-item @(current == last ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(current + 1)" aria-label="Next page">&rsaquo;</a>
                </li>

                <li class="page-item @(current == last ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@last" aria-label="Last page">&raquo;</a>
                </li>

            </ul>
        </nav>
    }

</div>