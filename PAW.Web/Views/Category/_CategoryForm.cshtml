@model PAW.Models.DTO.CategoryDTO

@* Campos compartidos por Create y Edit *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" />
        <span asp-validation-for="CategoryName" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ModifiedBy" class="form-label"></label>
        <input asp-for="ModifiedBy" class="form-control" />
        <span asp-validation-for="ModifiedBy" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
