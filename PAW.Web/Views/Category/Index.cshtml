@model CategoryViewModel
@{
    ViewData["Title"] = "Category Page";
}

<div class="container mt-4">

    @await Html.PartialAsync("ExchangeRate", Model.TipoCambio)

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Categories</h2>

        <a asp-action="Create" class="btn btn-primary">
            Add Category
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Category ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Categories.Items.Any())
                        {
                            foreach (var category in Model.Categories.Items)
                            {
                                <tr>
                                    <td>@category.CategoryId</td>
                                    <td><strong>@category.CategoryName</strong></td>
                                    <td>@category.Description</td>
                                    <td>@category.ModifiedBy</td>
                                    <td>@category.LastModified?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@category.CategoryId"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@category.CategoryId"
                                               data-details="Category details"
                                               class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@category.CategoryId"
                                               class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No categories found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_Pager" model="Model.Categories" />

        </div>
    </div>

</div>
