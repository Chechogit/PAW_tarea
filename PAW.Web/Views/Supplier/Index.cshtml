@model SupplierViewModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="container mt-4">

    @await Html.PartialAsync("ExchangeRate", Model.TipoCambio)

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Suppliers</h2>

        <a asp-action="Create" class="btn btn-primary">
            Add Supplier
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Supplier ID</th>
                            <th>Name</th>
                            <th>Contact Name</th>
                            <th>Phone</th>
                            <th>City</th>
                            <th>Country</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Suppliers.Items.Any())
                        {
                            foreach (var item in Model.Suppliers.Items)
                            {
                                <tr>
                                    <td>@item.SupplierId</td>
                                    <td><strong>@item.SupplierName</strong></td>
                                    <td>@item.ContactName</td>
                                    <td>@item.Phone</td>
                                    <td>@item.City</td>
                                    <td>@item.Country</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.SupplierId"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.SupplierId"
                                               data-details="Supplier details"
                                               class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.SupplierId"
                                               class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">
                                    No records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <partial name="_Pager" model="Model.Suppliers" />

        </div>
    </div>

</div>
